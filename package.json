{
  "name": "tizen-homebrew",
  "version": "0.4.7",
  "private": true,
  "description": "Install apps on a Samsung Tizen TV from your phone.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SushyDev/tizen-homebrew.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "service",
    "ui"
  ],
  "scripts": {
    "doctor": "node tools/doctor.js",
    "lint": "eslint .",
    "build": "node tools/build.js",
    "test": "node tools/test.js",
    "test:matrix": "node tools/matrix.js",
    "package": "node tools/package.js",
    "bootstrap": "node tools/bootstrap.js",
    "full-bootstrap": "node tools/full-bootstrap.js",
    "duid": "node tools/duid.js",
    "mint": "node tools/mint.js",
    "certs": "node tools/certs.js",
    "push": "node tools/push.js",
    "repl": "node tools/repl.js",
    "dev": "npm run dev --workspace ui",
    "dev:service": "node --require ./tools/dev-global.js service/src/main.js",
    "clean": "node tools/clean.js",
    "version": "node tools/version.js",
    "version:check": "node tools/version.js --check",
    "version:set": "node tools/version.js --set"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "eslint": "^10.12.0",
    "jszip": "^3.10.2",
    "tizen": "git+https://github.com/reisxd/tizen.js.git#45b00106149d0c8eff74ead4a979c909dd80efd6",
    "ws": "^8.22.0"
  }
}
